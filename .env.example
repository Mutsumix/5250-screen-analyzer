# AI Service Configuration
# Uncomment and set the API key for your preferred AI service

# OpenAI (GPT)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Settings
# Update check interval in milliseconds (default: 2000ms)
CAPTURE_INTERVAL=2000

# OCR Language (default: eng+jpn)
OCR_LANGUAGE=eng+jpn